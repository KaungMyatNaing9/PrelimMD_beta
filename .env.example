APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://prelimmd:prelimmd@localhost:5432/prelimmd
ARTIFACT_ROOT=./artifacts
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=5
# Vision model, used where geometry and OCR cannot associate a label with its value
# (real scans) or read handwriting. One of:
#   disabled   - geometric + OCR extraction only
#   ollama     - local model, free, nothing leaves the machine.
#                Requires: ollama serve && ollama pull qwen2.5vl:7b
#   anthropic  - Claude vision. Higher accuracy, costs per call, needs VISION_API_KEY.
VISION_PROVIDER=disabled
# Defaults per provider: ollama -> qwen2.5vl:7b, anthropic -> claude-opus-5
VISION_MODEL=
VISION_API_KEY=
# Local models are slower than an API; allow generous headroom.
VISION_TIMEOUT_SECONDS=120
OCR_PROVIDER=local
# Which engine reads a page: "tesseract" (default) or "rapidocr". Tesseract is markedly
# better on clean forms; rapidocr sees roughly twice as much text on real scans. Neither
# wins everywhere, so the default stays tesseract and this is opt-in.
OCR_ENGINE=tesseract
OCR_LANGUAGE=eng
DEFAULT_REVIEW_THRESHOLD=0.75
DEBUG_SAVE_FIELD_CROPS=false
