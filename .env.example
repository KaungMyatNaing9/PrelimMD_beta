APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql+psycopg://prelimmd:prelimmd@localhost:5432/prelimmd
ARTIFACT_ROOT=./artifacts
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=5
# Vision model, used where geometry and OCR cannot associate a label with its value
# (real scans) or read handwriting. One of:
#   disabled   - geometric + OCR extraction only
#   ollama     - local model, free, nothing leaves the machine.
#                Requires: ollama serve && ollama pull qwen2.5vl:7b
#   groq       - Qwen3.8-27B on Groq. Free tier (no card), page data leaves the
#                machine, does not train on inputs even unpaid. Needs VISION_API_KEY
#                from console.groq.com.
#   anthropic  - Claude vision. Higher accuracy, costs per call, needs VISION_API_KEY.
# The shipped default is "disabled": the prototype reads a page with geometry and OCR
# alone, needs no model, no key and no network, and a demo cannot be slowed or stopped by
# any of the three. Turn one on deliberately.
VISION_PROVIDER=disabled
# Defaults per provider: ollama -> qwen2.5vl:7b, groq -> qwen3.8-27b,
# anthropic -> claude-opus-5
VISION_MODEL=
VISION_API_KEY=
# Local models are slower than an API; allow generous headroom.
VISION_TIMEOUT_SECONDS=120
# The local vision model reads every reviewer-taught slot of a photograph, all of a
# page's slots on one numbered sheet (one call a page, about a minute locally), and
# corrects what OCR misread there; it never overrules the furniture rules. "disabled"
# or "ollama" (needs the same qwen2.5vl:7b as VISION_PROVIDER=ollama).
SLOT_VISION=disabled
OCR_PROVIDER=local
# Which engine reads a page: "tesseract" (default) or "rapidocr". Tesseract is markedly
# better on clean forms; rapidocr sees roughly twice as much text on real scans. Neither
# wins everywhere, so the default stays tesseract and this is opt-in.
OCR_ENGINE=tesseract
OCR_LANGUAGE=eng
DEFAULT_REVIEW_THRESHOLD=0.75
DEBUG_SAVE_FIELD_CROPS=false
